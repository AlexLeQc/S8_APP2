@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Comments";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

@model List<string>

<h2>Commentaires</h2>

@foreach (var comment in Model)
{
    <div>
        @comment
    </div>
}

<input id="__RequestVerificationToken" type="hidden" value="@token" />
<textarea rows="2" cols="20" id="NewComment" style="display:none;"></textarea>

<input id="NewCommentsBtn" onclick="AddComments();" value="Nouveau commentaire" type="button" />
